{
  "name": "dsh-workbench",
  "version": "0.1.0-alpha.17",
  "description": "DSH 项目工作台：本地项目、任务计划、阶段回报和人工验收",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Sycun/dsh-workbench.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/connectors.js",
    "!lib/kali.js",
    "!lib/native-workers.js",
    "!lib/team-prompts.js",
    "!lib/team-tools.js",
    "!lib/work-orders.js",
    "cordis.patch.yml",
    "README.md",
    "docs/project-lifecycle.md",
    "docs/project-outputs.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:host": "node scripts/check-host.mjs",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "react": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": "0.2.2-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-file-upload"
      ]
    }
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
